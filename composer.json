{
    "name": "rupcom/lottery-toolkit",
    "description": "Framework-independent lottery rules, draw imports, descriptive statistics and ticket matching, with an optional Symfony bridge.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "lottery",
        "statistics",
        "lotto",
        "symfony",
        "eurojackpot"
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/framework-bundle": "^6.4 || ^7.0",
        "symfony/process": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "suggest": {
        "symfony/framework-bundle": "Required to enable the optional Symfony bundle (^6.4 or ^7.0).",
        "symfony/console": "Required to run the Symfony Console example (^6.4 or ^7.0)."
    },
    "autoload": {
        "psr-4": {
            "Rupcom\\LotteryToolkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rupcom\\LotteryToolkit\\Tests\\": "tests/",
            "LotteryToolkitExample\\": "examples/symfony/src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@composer validate --strict",
            "@test",
            "@analyse",
            "@cs:check"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": false
    },
    "archive": {
        "exclude": [
            "/vendor",
            "/.git",
            "/.cache",
            "/.phpunit.cache",
            "/.phpstan.cache",
            "/.php-cs-fixer.cache",
            "/site",
            "/composer.lock",
            "/.idea",
            "/.env*",
            "/examples/symfony/var",
            "/examples/symfony/config/reference.php",
            "/.github",
            "/tests",
            "/tools",
            "/phpunit.xml.dist",
            "/phpstan.neon",
            "/.php-cs-fixer.dist.php",
            "/mkdocs.yml"
        ]
    }
}
